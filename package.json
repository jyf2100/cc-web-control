{
  "name": "cc-web-control",
  "version": "2.0.2",
  "description": "通过 Web 页面以对话框形式控制本地 tmux 会话",
  "type": "module",
  "main": "server.cjs",
  "bin": {
    "cc-web-control": "bin/cc-web-control.cjs",
    "cc-web-control-tunnel": "bin/cc-web-control-tunnel.cjs"
  },
  "files": [
    "*.cjs",
    "*.example.json",
    "public/",
    "claude-wrapper.sh",
    "bin/",
    "scripts/restart_tunnel.sh"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "tmux",
    "remote-control",
    "websocket",
    "claude-code"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jyf2100/cc-web-control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyf2100/cc-web-control.git"
  },
  "bugs": {
    "url": "https://github.com/jyf2100/cc-web-control/issues"
  },
  "author": "jyf2100"
}
