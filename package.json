{
  "name": "cc-web-control",
  "version": "1.0.1",
  "description": "通过 Web 页面以对话框形式控制本地 tmux 会话",
  "type": "module",
  "main": "server.cjs",
  "bin": {
    "cc-web-control": "bin/cc-web-control.cjs"
  },
  "files": [
    "*.cjs",
    "public/",
    "claude-wrapper.sh",
    "bin/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.cjs",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "tmux",
    "remote-control",
    "websocket",
    "claude-code"
  ],
  "license": "MIT"
}
